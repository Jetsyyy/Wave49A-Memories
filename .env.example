# Neon: Project dashboard -> Connect -> copy the connection string (pooled is fine)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Any long random string (32+ characters). Keeps people logged in securely.
JWT_SECRET=change-me-to-a-long-random-string

# Created automatically when you connect a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# Your username (comma-separate several). These people are admins and can sign up without a code.
# Admins create invite codes for each team on the Admin page.
ADMIN_USERNAMES=your.username

# Optional: one shared backup code that always works. Leave empty to use only admin-made codes.
INVITE_CODE=

# Optional: free key from https://developers.giphy.com to enable GIF search.
GIPHY_API_KEY=

# Local testing without Neon: DATABASE_URL=pglite:./.localdb
